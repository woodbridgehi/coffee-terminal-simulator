{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://coffee-terminal.example/schemas/showcase-v1.json",
  "title": "Coffee Terminal Showcase Package v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "version", "name", "designSize", "slides"],
  "properties": {
    "schemaVersion": {"const": 1},
    "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
    "version": {"type": "string", "pattern": "^[0-9]{1,4}\\.[0-9]{1,4}\\.[0-9]{1,4}$"},
    "name": {"type": "string", "minLength": 1, "maxLength": 100},
    "designSize": {"type": "object", "additionalProperties": false, "required": ["width", "height"], "properties": {"width": {"type": "integer", "minimum": 320, "maximum": 3840}, "height": {"type": "integer", "minimum": 320, "maximum": 2160}}},
    "playlist": {"type": "string", "enum": ["sequence", "interleave-products"]},
    "background": {"type": "string", "pattern": "^#[0-9a-fA-F]{6}$"},
    "slides": {"type": "array", "minItems": 1, "maxItems": 60, "items": {"$ref": "#/$defs/slide"}}
  },
  "$defs": {
    "copy": {"type": "object", "additionalProperties": false, "required": ["title"], "properties": {
      "title": {"type": "string", "maxLength": 160}, "body": {"type": "string", "maxLength": 1500}, "eyebrow": {"type": "string", "maxLength": 80}, "author": {"type": "string", "maxLength": 80}
    }},
    "localized": {"type": "object", "additionalProperties": false, "required": ["zh-CN", "en-US"], "properties": {"zh-CN": {"$ref": "#/$defs/copy"}, "en-US": {"$ref": "#/$defs/copy"}}},
    "path": {"type": "string", "minLength": 1, "maxLength": 160, "pattern": "^(assets|slides)/[a-zA-Z0-9_./-]+$"},
    "slide": {"type": "object", "additionalProperties": false, "required": ["id", "type"], "properties": {
      "id": {"type": "string", "pattern": "^[a-z][a-z0-9-]{0,47}$"},
      "type": {"type": "string", "enum": ["image", "svg", "text", "review", "product", "html", "animation"]},
      "src": {"$ref": "#/$defs/path"},
      "srcByLocale": {"type": "object", "additionalProperties": false, "required": ["zh-CN", "en-US"], "properties": {"zh-CN": {"$ref": "#/$defs/path"}, "en-US": {"$ref": "#/$defs/path"}}},
      "content": {"$ref": "#/$defs/localized"},
      "durationMs": {"type": "integer", "minimum": 1000, "maximum": 24000},
      "duration": {"const": "auto"},
      "fit": {"type": "string", "enum": ["cover", "contain"]},
      "layout": {"type": "string", "enum": ["canvas", "responsive"]},
      "template": {"type": "string", "enum": ["editorial", "quote"]},
      "enabled": {"type": "boolean"}, "approved": {"type": "boolean"}
    }}
  }
}
