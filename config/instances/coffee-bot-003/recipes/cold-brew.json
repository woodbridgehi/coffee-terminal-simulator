      "robotActions": ["brew"],
      "consumes": [
        { "materialId": "coffee-beans", "amount": 20, "unit": "g" },
        { "materialId": "water", "amount": 120, "unit": "ml" }
      ]
    },
    {
      "id": "add-ice",
      "name": "加入冰块",
      "animationCue": "ice-drop",
