      "robotActions": ["ice"],
      "consumes": [{ "materialId": "ice", "amount": 180, "unit": "g" }]
    },
    {
      "id": "seal-and-serve",
      "name": "封杯并出杯",
      "animationCue": "seal",
      "durationSeconds": 10,
      "durationRandomization": { "minSeconds": 9, "maxSeconds": 13 },
      "failureProfile": "lid-dispenser",
