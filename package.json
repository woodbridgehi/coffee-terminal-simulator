{
  "name": "coffee-terminal-scene",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "build:showcase": "node scripts/build_showcase.mjs",
    "build:scene": "node scripts/build_scene.mjs",
    "sync:cloud-scene": "npm run build:scene && node scripts/sync_cloud_scene.mjs",
    "test:scene": "node --test tests/test_robot_scene.mjs",
    "test": "node --test tests/*.mjs tests/twin/*.mjs",
    "build:twin": "node scripts/build_twin.mjs",
    "start:twin": "npm run build:twin && python3 scripts/serve_scene.py --twin",
    "twin:run": "node scripts/run_twin.mjs",
    "test:twin": "node --test tests/twin/*.mjs",
    "twin:serve": "npm run build:twin && node scripts/serve_twin_devices.mjs",
    "twin:plan": "node scripts/plan_twin_drink.mjs"
  },
  "dependencies": {
    "@dimforge/rapier3d-compat": "0.20.0",
    "three": "0.185.1"
  },
  "devDependencies": {
    "esbuild": "0.28.2"
  }
}
